# Copy to .env and fill in real values. .env is gitignored — never commit it.

# HTTP server
PORT=8080

# Comma-separated browser origins allowed to call the API.
# Vite dev server runs on 5173.
ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=renthouse
DB_SSLMODE=disable

# Signing key for JWTs. Required — the server refuses to start without it.
# Generate one with: openssl rand -base64 32
JWT_SECRET=change-me

# Access-token lifetime, as a Go duration (24h, 30m, 15m).
JWT_EXPIRES_IN=24h

# One-time codes for registration.
OTP_EXPIRATION=5m
OTP_RESEND_COOLDOWN=60s
OTP_MAX_ATTEMPTS=5

# How long a verified registration session may take to finish the profile form.
REGISTRATION_TOKEN_EXPIRATION=15m

# ---------------------------------------------------------------------------
# Verification code delivery
#
# Both default to "dev", which WRITES CODES TO THE SERVER LOG and sends nothing.
# Selecting a real provider without its credentials makes the server refuse to
# start, rather than silently falling back to logging.
# ---------------------------------------------------------------------------

# dev | resend
EMAIL_PROVIDER=dev
# Create at https://resend.com -> API Keys
RESEND_API_KEY=
# Must be on a domain verified in the Resend dashboard, e.g.
# "RentHouse <no-reply@yourdomain.uz>". Before a domain is verified Resend only
# accepts onboarding@resend.dev and only delivers to your own account address.
RESEND_FROM=
RESEND_SUBJECT=RentHouse tasdiqlash kodi
RESEND_BODY=RentHouse tasdiqlash kodingiz: {code}

# dev | eskiz
SMS_PROVIDER=dev
# The account you sign in to https://my.eskiz.uz with
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Registered sender id. 4546 is Eskiz's shared test sender.
ESKIZ_FROM=4546
# Must match a template approved by Eskiz moderation, or every send is rejected.
ESKIZ_MESSAGE=RentHouse tasdiqlash kodi: {code}
