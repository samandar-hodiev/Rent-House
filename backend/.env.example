# Copy to .env and fill in real values. .env is gitignored — never commit it.

# HTTP server
PORT=8080

# Comma-separated browser origins allowed to call the API.
# Vite dev server runs on 5173.
ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=renthouse
DB_SSLMODE=disable

# Signing key for JWTs. Required — the server refuses to start without it.
# Generate one with: openssl rand -base64 32
JWT_SECRET=change-me

# Access-token lifetime, as a Go duration (24h, 30m, 15m).
JWT_EXPIRES_IN=24h

# One-time codes for registration.
OTP_EXPIRATION=5m
OTP_RESEND_COOLDOWN=60s
OTP_MAX_ATTEMPTS=5

# How long a verified registration session may take to finish the profile form.
REGISTRATION_TOKEN_EXPIRATION=15m

# ---------------------------------------------------------------------------
# IP-based rate limits
#
# Account lockout already throttles one identifier at a time; these guard
# endpoints a script can hit with no account at all (registration, password
# reset) or by cycling through many (login), plus listing creation, so
# moderation never has to absorb a flood from one address.
# ---------------------------------------------------------------------------
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW=15m
RATE_LIMIT_PASSWORD_RESET_MAX=5
RATE_LIMIT_PASSWORD_RESET_WINDOW=15m
RATE_LIMIT_LOGIN_MAX=30
RATE_LIMIT_LOGIN_WINDOW=5m
RATE_LIMIT_LISTING_MAX=20
RATE_LIMIT_LISTING_WINDOW=1h

# ---------------------------------------------------------------------------
# Verification code delivery
#
# Both default to "dev", which WRITES CODES TO THE SERVER LOG and sends nothing.
# Selecting a real provider without its credentials makes the server refuse to
# start, rather than silently falling back to logging.
# ---------------------------------------------------------------------------

# dev | resend
# dev | resend | smtp
EMAIL_PROVIDER=dev
# Create at https://resend.com -> API Keys
RESEND_API_KEY=
# Must be on a domain verified in the Resend dashboard, e.g.
# "RentHouse <no-reply@yourdomain.uz>". Before a domain is verified Resend only
# accepts onboarding@resend.dev and only delivers to your own account address.
RESEND_FROM=
RESEND_SUBJECT=RentHouse tasdiqlash kodi
RESEND_BODY=RentHouse tasdiqlash kodingiz: {code}

# EMAIL_PROVIDER=smtp — any mailbox that can send mail, to any recipient, with
# no domain to verify. This is the route that works before you own a domain.
#
# Gmail: enable 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords and put it in SMTP_PASSWORD. Your
# normal Google password will not work. Roughly 500 messages a day.
# Brevo, SendGrid and Mailgun all speak SMTP too — only these five values change.
#
# Port 465 is implicit TLS; anything else (587 is the usual) is upgraded with
# STARTTLS. The password is never sent over an unencrypted connection.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Most servers require this to match SMTP_USERNAME; Gmail rewrites it if not.
SMTP_FROM=RentHouse <your-address@gmail.com>
SMTP_SUBJECT=RentHouse tasdiqlash kodi
SMTP_BODY=

# dev | eskiz
SMS_PROVIDER=dev
# The account you sign in to https://my.eskiz.uz with
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Registered sender id. 4546 is Eskiz's shared test sender.
ESKIZ_FROM=4546
# Must match a template approved by Eskiz moderation, or every send is rejected.
ESKIZ_MESSAGE=RentHouse tasdiqlash kodi: {code}

# The first admin-dashboard owner, created by `go run ./cmd/admin`.
#
# Read only by that command and only when no owner exists yet — there is no
# endpoint that creates an owner, because a route that mints the most
# privileged account is a door that only has to be left open once. Every other
# administrator is created by the owner from the dashboard.
ADMIN_OWNER_NAME=
ADMIN_OWNER_EMAIL=
ADMIN_OWNER_PASSWORD=
