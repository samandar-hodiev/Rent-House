# Copy to .env and fill in real values. .env is gitignored — never commit it.

# HTTP server
PORT=8080

# Comma-separated browser origins allowed to call the API.
# Vite dev server runs on 5173.
ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=renthouse
DB_SSLMODE=disable

# Signing key for JWTs. Required at startup even though authentication is not
# implemented yet, so a deployment cannot come up without one configured.
# Generate one with: openssl rand -base64 32
JWT_SECRET=change-me
