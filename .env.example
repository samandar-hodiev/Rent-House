# Docker Compose infrastructure settings — copy to .env before `make up`.
#
# backend/.env (copied from backend/.env.example) holds the application's own
# secrets: JWT_SECRET, the email/SMS providers, the admin bootstrap account.
# The database credentials below are deliberately not part of that file: they
# have to match on both sides — the Postgres container this starts, and
# whatever the backend/migrate/seed containers connect with — and keeping one
# value in two files is how the two drift apart. docker-compose.yml reads
# these once and applies them to both sides itself.

# `make env` replaces DB_PASSWORD with a random value the first time it
# copies this file, so this placeholder is what you get only if you copy the
# file by hand instead — replace it before running anything against a
# database anyone else can reach.
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_run_make_env_or_paste_output_of_openssl_rand_-base64_24
DB_NAME=renthouse

# Host ports. Only worth changing if one of these already belongs to
# something else on this machine. POSTGRES_PORT does nothing unless you
# uncomment the matching `ports:` line in docker-compose.yml — see the
# comment there for why it stays closed by default.
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Where the browser actually reaches this deployment — the backend's CORS
# allow-list. Also not part of backend/.env, for the same reason the database
# credentials above aren't: it has to match wherever this compose file
# actually publishes the frontend, and the default below is only right for
# FRONTEND_PORT=3000 on your own machine. Deploying to a real domain, set this
# to it instead, e.g. ALLOWED_ORIGINS=https://renthouse.uz — comma-separated
# if the site answers on more than one origin.
ALLOWED_ORIGINS=http://localhost:3000

# Optional: the Map page's key, baked into the frontend build. Blank means
# the map page degrades rather than the build failing. See
# frontend/.env.example for where to get one.
VITE_YANDEX_MAPS_API_KEY=
