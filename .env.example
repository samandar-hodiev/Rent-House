# Docker Compose infrastructure settings — copy to .env before `make up`.
#
# backend/.env (copied from backend/.env.example) holds the application's own
# secrets: JWT_SECRET, the email/SMS providers, the admin bootstrap account.
# The database credentials below are deliberately not part of that file: they
# have to match on both sides — the Postgres container this starts, and
# whatever the backend/migrate/seed containers connect with — and keeping one
# value in two files is how the two drift apart. docker-compose.yml reads
# these once and applies them to both sides itself.

DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=renthouse

# Host ports. Only worth changing if one of these already belongs to
# something else on this machine.
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Optional: the Map page's key, baked into the frontend build. Blank means
# the map page degrades rather than the build failing. See
# frontend/.env.example for where to get one.
VITE_YANDEX_MAPS_API_KEY=
