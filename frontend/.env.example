# Yandex Maps JS API key, used by the Map page (see src/utils/yandexMaps.js).
# Get one at https://developer.tech.yandex.ru/services (JavaScript API and
# Geocoder). Copy this file to `.env.local` and fill in the value —
# `.env*` files are gitignored, so the key is never committed.
VITE_YANDEX_MAPS_API_KEY=

# Base URL of the RentHouse API, including the /api/v1 prefix.
# The backend listens on 8080 by default; this project uses 8081 locally
# because GitPulse already holds 8080.
VITE_API_URL=http://localhost:8080/api/v1
